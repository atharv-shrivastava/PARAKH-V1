generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String        @id @default(cuid())
  name                        String
  email                       String        @unique
  passwordHash                String?
  emailVerified               Boolean       @default(false)
  emailVerificationOtpHash    String?
  emailVerificationOtpExpiresAt DateTime?
  emailVerificationLastSentAt DateTime?
  emailVerificationAttempts   Int           @default(0)
  role                        String        @default("USER")
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  sessions                    Session[]
  scans                       Scan[]
  inspections                 Inspection[]
  categories                  Category[]
  products                    Product[]
  shops                       Shop[]
  rulesCreated                ComplianceRule[] @relation("RuleCreatedBy")
  batchIncidentsCreated       BatchIncidentReport[] @relation("BatchIncidentReporter")
  batchAlertsCreated          BatchAlert[] @relation("BatchAlertCreator")
  batchAlertsVerified         BatchAlert[] @relation("BatchAlertVerifier")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Shop {
  id          String        @id @default(cuid())
  name        String
  address     String?
  city        String?
  state       String?
  latitude    Float?
  longitude   Float?
  sourceType  String        @default("OFFLINE")
  ownerId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  inspections Inspection[]

  @@index([name])
  @@index([ownerId])
  @@index([sourceType])
  @@index([city])
  @@index([state])
}

model Category {
  id                 String     @id @default(cuid())
  name               String
  slug               String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  parentId           String?
  isSystem           Boolean    @default(false)
  sourceType         String     @default("OFFLINE")
  ownerId            String?
  isFinalProductType Boolean    @default(false)
  parent             Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[] @relation("CategoryHierarchy")
  products           Product[]
  owner              User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([parentId, slug])
  @@index([ownerId])
  @@index([isSystem])
  @@index([parentId])
  @@index([isFinalProductType])
  @@index([sourceType])
}

model Product {
  id                String        @id @default(cuid())
  brandName         String?
  manufacturerName  String?
  productName       String
  description       String?
  ocrData           String?
  netQuantity       String?
  unit              String?
  mrp               Float?
  barcode            String?
  imageUrl           String?
  imageUrls         Json          @default("[]")
  complianceStatus  String        @default("NEEDS_REVIEW")
  violationReason   String?
  sourceType        String        @default("OFFLINE")
  sourceUrl         String?
  sourceWebsiteName String?
  ownerId           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner             User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  inspections       Inspection[]
  batchAlerts       BatchAlert[]
  batchIncidents    BatchIncidentReport[]

  @@index([categoryId])
  @@index([ownerId])
  @@index([brandName])
  @@index([manufacturerName])
  @@index([productName])
  @@index([barcode])
  @@index([complianceStatus])
  @@index([sourceType])
  @@index([createdAt])
}

model Scan {
  id          String      @id @default(cuid())
  imageUrl    String?
  ocrText     String?
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
  workerId    String
  worker      User        @relation(fields: [workerId], references: [id], onDelete: Restrict)
  inspection  Inspection?
}

model Inspection {
  id                String    @id @default(cuid())
  status            String    @default("NEEDS_REVIEW")
  notes             String?
  violationType     String?
  violationSeverity String?
  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  inspectedAt       DateTime  @default(now())
  workerId          String
  shopId            String
  productId         String
  batchNumber       String?
  scanId            String?   @unique
  worker            User      @relation(fields: [workerId], references: [id], onDelete: Restrict)
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  scan              Scan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)
  batchIncidents    BatchIncidentReport[]

  @@index([shopId])
  @@index([productId])
  @@index([workerId])
  @@index([inspectedAt])
  @@index([batchNumber])
  @@index([status])
  @@index([isVerified])
  @@index([violationSeverity])
  @@index([violationType])
}

model BatchIncidentReport {
  id              String      @id @default(cuid())
  productId       String
  batchNumber     String
  inspectionId    String?
  reportedById    String
  title           String
  description     String
  severity        String      @default("HIGH")
  status          String      @default("REPORTED")
  evidenceUrl     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inspection      Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  reportedBy      User        @relation("BatchIncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  batchAlertId    String?
  batchAlert      BatchAlert? @relation(fields: [batchAlertId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([batchNumber])
  @@index([status])
  @@index([severity])
  @@index([reportedById])
}

model BatchAlert {
  id              String        @id @default(cuid())
  productId       String
  batchNumber     String
  title           String
  message         String
  severity        String        @default("HIGH")
  status          String        @default("ACTIVE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String
  verifiedById    String?
  verifiedAt      DateTime?
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("BatchAlertCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy      User?         @relation("BatchAlertVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  incidents       BatchIncidentReport[]

  @@unique([productId, batchNumber])
  @@index([batchNumber])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model ComplianceRule {
  id              String   @id @default(cuid())
  ruleId          String   @unique
  ruleCode        String
  ruleNumber      String
  subclause       String?
  title           String
  description     String
  category        String
  defaultSeverity String
  enabled         Boolean  @default(true)
  isBuiltin       Boolean  @default(false)
  definition      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  createdBy       User?    @relation("RuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ruleCode])
  @@index([enabled])
  @@index([category])
  @@index([isBuiltin])
}
