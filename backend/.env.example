# Database / Prisma
DATABASE_URL=
DIRECT_URL=

# PARAKH OCR / semantic mapping
# RapidOCR is the local OCR/detection layer.
OCR_AI_PROVIDER=consensus
OCR_AI_API_KEY=
OCR_AI_MODEL=

# Gemini semantic vision model
GEMINI_API_KEY=
GEMINI_SEMANTIC_MODEL=gemini-3.7-flash

# Grok semantic vision model
XAI_API_KEY=
GROK_SEMANTIC_MODEL=grok-4.6

# Optional additional semantic verification providers
PARAKH_SEMANTIC_VERIFY_ALL=false

# Cloudflare Workers AI semantic vision models
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_SEMANTIC_MODEL=@cf/google/gemma-4-26b-a4b-it

# RapidOCR runtime
RAPID_OCR_URL=http://localhost:8081
RAPIDOCR_LANG_TYPE=en
RAPIDOCR_MAX_SIDE=768
RAPIDOCR_USE_CLS=false
RAPIDOCR_TEXT_SCORE=0.5
OCR_TIMEOUT_MS=30000
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MAX_IMAGE_SIZE_BYTES=8388608
OCR_MAX_IMAGES_PER_REQUEST=6

# DataKart reference database used for field verification
DATAKART_SUPABASE_URL=https://iaghrncbfpxpwcdgyuen.supabase.co
DATAKART_SUPABASE_KEY=
DATAKART_TIMEOUT_MS=4000

# Email verification (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AUTH_OTP_SECRET=
