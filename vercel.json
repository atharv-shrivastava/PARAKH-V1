{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install --no-audit --no-fund",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js",
      "installCommand": "npm install --no-audit --no-fund",
      "bindings": [
        {
          "type": "service",
          "service": "ocr",
          "format": "url",
          "env": "RAPID_OCR_URL"
        },
        {
          "type": "service",
          "service": "vision",
          "format": "url",
          "env": "OPENCV_VISION_URL"
        },
        {
          "type": "service",
          "service": "rules-engine",
          "format": "url",
          "env": "RULES_ENGINE_URL"
        }
      ]
    },
    "ocr": {
      "root": "ocr-service",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 120
        }
      }
    },
    "vision": {
      "root": "vision-service",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 60
        }
      }
    },
    "rules-engine": {
      "root": "rules-engine",
      "framework": "node",
      "entrypoint": "server.mjs",
      "installCommand": "npm install --no-audit --no-fund",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
