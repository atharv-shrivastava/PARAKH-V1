# Local RapidOCR service
# 0 = preserve uploaded source resolution
RAPIDOCR_MAX_SIDE=0
# Internal detector/recognizer processing cap. Keep high to avoid downscaling normal phone/camera originals.
RAPIDOCR_ENGINE_MAX_SIDE=10000
RAPIDOCR_LANG_TYPE=en
RAPIDOCR_USE_CLS=false
RAPIDOCR_USE_CUDA=true
RAPIDOCR_CUDA_DEVICE=0
RAPIDOCR_USE_DML=false
RAPIDOCR_TEXT_SCORE=0.5
RAPIDOCR_CACHE_TTL_SECONDS=120
RAPIDOCR_CACHE_ITEMS=8

# Vision-model image path
# 0 = preserve uploaded source resolution
PARAKH_AI_MAX_IMAGE_SIDE=0
PARAKH_AI_JPEG_QUALITY=98
PARAKH_AI_PRESERVE_FORMAT=true
